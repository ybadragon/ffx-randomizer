<mah:MetroWindow x:Class="FfxRandomizer.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:vm="clr-namespace:FfxRandomizer.App.ViewModels"
                 Title="FFX Randomizer" TitleCharacterCasing="Normal" TitleBarHeight="48"
                 WindowTitleBrush="{StaticResource TitleBar}" NonActiveWindowTitleBrush="{StaticResource TitleBar}"
                 GlowBrush="{StaticResource Border}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                 Background="{StaticResource Window}" FontFamily="{StaticResource UiFont}"
                 Width="1180" Height="820" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterScreen">

    <mah:MetroWindow.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <TextBlock Text="FFX Randomizer" FontSize="24" FontWeight="Light" Foreground="White" />
                <TextBlock Text="{Binding DataContext.Version, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="13" Foreground="#C9D7EA" Margin="12,0,0,3" VerticalAlignment="Bottom" />
            </StackPanel>
        </DataTemplate>
    </mah:MetroWindow.TitleTemplate>

    <mah:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="Show" />

        <!-- Options tab: one feature box. -->
        <DataTemplate x:Key="GroupTemplate" DataType="{x:Type vm:GroupViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" IsEnabled="{Binding Implemented}">
                <StackPanel>
                    <Border Background="{StaticResource PanelHeader}" CornerRadius="6,6,0,0" Padding="14,10">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsOn}"
                                      Visibility="{Binding HasToggle, Converter={StaticResource Show}}"
                                      AutomationProperties.Name="{Binding Title}" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}" FontSize="15" />
                            </CheckBox>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}" FontSize="15" Margin="2,0,8,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Visibility>
                                    <Binding Path="HasToggle" Converter="{x:Static vm:Converters.HideWhenTrue}" />
                                </TextBlock.Visibility>
                            </TextBlock>
                            <Border Style="{StaticResource Chip}" Visibility="{Binding HasBadge, Converter={StaticResource Show}}" Margin="4,0,0,0">
                                <TextBlock Text="{Binding Badge}" />
                            </Border>
                            <Border Style="{StaticResource GoodChip}" Margin="6,0,0,0" ToolTip="{Binding SaveImpact.Note}"
                                    Visibility="{Binding ShowsOnExistingSaves, Converter={StaticResource Show}}">
                                <TextBlock Text="{Binding SaveImpact.Label}" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Margin="6,0,0,0" ToolTip="{Binding SaveImpact.Note}"
                                    Visibility="{Binding ShowsPartly, Converter={StaticResource Show}}">
                                <TextBlock Text="{Binding SaveImpact.Label}" />
                            </Border>
                            <Border Style="{StaticResource WarnChip}" Margin="6,0,0,0" ToolTip="{Binding SaveImpact.Note}"
                                    Visibility="{Binding ShowsNewGameOnly, Converter={StaticResource Show}}">
                                <TextBlock Text="{Binding SaveImpact.Label}" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="16,12,16,14">
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" />
                        <Border Background="{StaticResource WarnBack}" CornerRadius="4" Padding="10,8" Margin="0,10,0,0"
                                Visibility="{Binding ShowWarning, Converter={StaticResource Show}}">
                            <TextBlock Text="{Binding Warning}" Style="{StaticResource Small}" Foreground="{StaticResource WarnText}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Choices}" Margin="0,10,0,0"
                                      Visibility="{Binding ShowChoices, Converter={StaticResource Show}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChoiceViewModel}">
                                    <RadioButton Style="{StaticResource PillChoice}" Content="{Binding Label}"
                                                 GroupName="{Binding GroupName}" IsChecked="{Binding IsSelected}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Margin="0,12,0,0" DataContext="{Binding Dropdown}"
                                    Visibility="{Binding IsVisible, Converter={StaticResource Show}, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Strong}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedId}" MinWidth="180" AutomationProperties.Name="{Binding Label}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Record…" Margin="8,0,0,0"
                                        Command="{Binding RecordCommand}" ToolTip="Record it from your controller"
                                        Visibility="{Binding CanRecord, Converter={StaticResource Show}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding RecordStatus}" Style="{StaticResource Small}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <Border Background="{StaticResource WarnBack}" CornerRadius="4" Padding="10,6" Margin="0,6,0,0"
                                    Visibility="{Binding HasWarning, Converter={StaticResource Show}}">
                                <TextBlock Text="{Binding Warning}" Style="{StaticResource Small}" Foreground="{StaticResource WarnText}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Small}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding SubOptions}" Margin="0,10,0,0"
                                      Visibility="{Binding ShowSubOptions, Converter={StaticResource Show}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SubOptionViewModel}">
                                    <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="0,8">
                                        <Grid IsEnabled="{Binding Implemented}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsOn}">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                            </CheckBox>
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Border Style="{StaticResource WarnChip}" CornerRadius="4"
                                                        Visibility="{Binding HasWarning, Converter={StaticResource Show}}">
                                                    <TextBlock Text="{Binding Warning}" />
                                                </Border>
                                                <Border Style="{StaticResource Chip}" Visibility="{Binding ComingSoon, Converter={StaticResource Show}}">
                                                    <TextBlock Text="Coming soon" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TagList">
            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Tag}"><TextBlock Text="{Binding}" /></Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- Presets tab: one preset card. -->
        <DataTemplate x:Key="PresetTemplate" DataType="{x:Type vm:PresetItemViewModel}">
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRenaming, Converter={x:Static vm:Converters.HideWhenTrue}}">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}" FontSize="16" />
                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Visibility="{Binding IsLoaded, Converter={StaticResource Show}}">
                                <TextBlock Text="Loaded" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRenaming, Converter={StaticResource Show}}">
                            <TextBox Style="{StaticResource Input}" Width="280" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Preset name" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Save" Margin="8,0,0,0" Command="{Binding FinishRenameCommand}" IsDefault="True" />
                            <Button Style="{StaticResource LinkButton}" Content="Cancel" Margin="4,0,0,0" Command="{Binding CancelRenameCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Small}" Margin="0,4,0,6" />
                        <ContentControl Content="{Binding Tags}" ContentTemplate="{StaticResource TagList}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Content="Load" Command="{Binding LoadCommand}" Margin="0,0,8,0"
                                Visibility="{Binding NotLoaded, Converter={StaticResource Show}}" />
                        <Button Style="{StaticResource IconButton}" ToolTip="Rename" AutomationProperties.Name="Rename preset" Margin="0,0,8,0"
                                Command="{Binding StartRenameCommand}" Visibility="{Binding Mine, Converter={StaticResource Show}}">
                            <Path Style="{StaticResource IconPath}" Data="M10.5,2.5 L13.5,5.5 L5,14 L2,14 L2,11 Z" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Duplicate" AutomationProperties.Name="Duplicate preset" Margin="0,0,8,0"
                                Command="{Binding DuplicateCommand}">
                            <Path Style="{StaticResource IconPath}" Data="M5,5 L14,5 L14,14 L5,14 Z M11,5 L11,2.5 L2.5,2.5 L2.5,11 L5,11" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Delete" AutomationProperties.Name="Delete preset"
                                Command="{Binding DeleteCommand}" Visibility="{Binding Mine, Converter={StaticResource Show}}">
                            <Path Style="{StaticResource IconPath}" Data="M2.5,4 L13.5,4 M6,4 L6,2.5 L10,2.5 L10,4 M4,4 L4.7,13.5 L11.3,13.5 L12,4" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- History tab: one run. -->
        <DataTemplate x:Key="HistoryTemplate" DataType="{x:Type vm:HistoryItemViewModel}">
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}" FontSize="16" />
                            <TextBlock Text="{Binding Kind}" Style="{StaticResource Small}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <Border Style="{StaticResource GoodChip}" Margin="10,0,0,0" Visibility="{Binding IsCurrent, Converter={StaticResource Show}}">
                                <TextBlock Text="In your game now" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Style="{StaticResource Small}" VerticalAlignment="Center">
                                <Run Text="{Binding Meta, Mode=OneWay}" /><Run Text="{Binding Seed, Mode=OneWay}" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                            </TextBlock>
                            <Button Style="{StaticResource IconButton}" Command="{Binding CopySeedCommand}" Margin="4,0,0,0" Padding="2"
                                    VerticalAlignment="Center" ToolTip="Copy seed" AutomationProperties.Name="Copy seed">
                                <Path Style="{StaticResource IconPath}" Data="M5.5,5.5 L13.5,5.5 L13.5,13.5 L5.5,13.5 Z M3,10.5 L2.5,10.5 L2.5,2.5 L10.5,2.5 L10.5,3" />
                            </Button>
                            <TextBlock Style="{StaticResource Small}" Text="Copied" Foreground="{StaticResource GoodText}" Margin="2,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding SeedCopied, Converter={StaticResource Show}}" />
                            <TextBlock Style="{StaticResource Small}" Text="{Binding Summary, Mode=OneWay}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ContentControl Content="{Binding Tags}" ContentTemplate="{StaticResource TagList}" Focusable="False" />
                        <TextBlock Text="{Binding VersionNote}" Style="{StaticResource Small}" Foreground="{StaticResource WarnText}"
                                   Visibility="{Binding FromOtherVersion, Converter={StaticResource Show}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource LinkButton}" Content="Spoiler log" Command="{Binding OpenSpoilerCommand}" Margin="0,0,8,0"
                                Visibility="{Binding HasSpoiler, Converter={StaticResource Show}}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Use settings" Command="{Binding UseSettingsCommand}" Margin="0,0,8,0"
                                ToolTip="Load these settings with a new random seed" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Replay this seed" Command="{Binding ReplaySeedCommand}" Margin="0,0,8,0"
                                ToolTip="Load these settings and this seed to make the exact same game" />
                        <Button Style="{StaticResource IconButton}" ToolTip="Delete from history" AutomationProperties.Name="Delete from history"
                                Command="{Binding DeleteCommand}">
                            <Path Style="{StaticResource IconPath}" Data="M2.5,4 L13.5,4 M6,4 L6,2.5 L10,2.5 L10,4 M4,4 L4.7,13.5 L11.3,13.5 L12,4" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Overlays. -->
        <DataTemplate DataType="{x:Type vm:RunViewModel}">
            <Grid Background="{StaticResource Window}">
                <!-- Progress -->
                <StackPanel Width="560" VerticalAlignment="Center" Visibility="{Binding IsFinished, Converter={x:Static vm:Converters.HideWhenTrue}}">
                    <TextBlock Text="Randomizing your game" Style="{StaticResource BigTitle}" />
                    <TextBlock Text="This takes a few seconds. Keep FINAL FANTASY X closed until it finishes." Style="{StaticResource Muted}" Margin="0,6,0,20" />
                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Height="8" Foreground="{StaticResource Accent}" Background="{StaticResource Divider}"
                                 AutomationProperties.Name="Progress" Margin="0,0,0,20" />
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RunStepViewModel}">
                                    <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="16,12">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="22" Height="22" Margin="0,0,14,0">
                                                <Ellipse x:Name="Ring" Stroke="{StaticResource BorderControl}" StrokeThickness="1.5" />
                                                <Path x:Name="Tick" Data="M6.5,11.5 L9.5,14.5 L15.5,8" Stroke="White" StrokeThickness="2" Visibility="Collapsed" />
                                            </Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Strong}" FontSize="14.5" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Current">
                                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Link}" />
                                            <Setter TargetName="Ring" Property="StrokeThickness" Value="3" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                            <Setter TargetName="Ring" Property="Fill" Value="{StaticResource GoodSolid}" />
                                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource GoodSolid}" />
                                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Finished -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsFinished, Converter={StaticResource Show}}">
                    <StackPanel Width="640" VerticalAlignment="Center" Margin="0,32">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="48" Height="48" Margin="0,0,16,0">
                                <Ellipse Fill="{StaticResource GoodSolid}" />
                                <Path Data="M14,25 L21,32 L34,18" Stroke="White" StrokeThickness="3.5" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Your game is randomized" Style="{StaticResource BigTitle}" />
                                <TextBlock Text="{Binding SeedLine}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Preset prompt -->
                        <StackPanel Margin="0,20,0,0" Visibility="{Binding PresetModified, Converter={StaticResource Show}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Strong}" Text="{Binding PresetName, StringFormat='Your settings no longer match &quot;{0}&quot;'}" />
                                <Border Style="{StaticResource WarnChip}" Margin="8,0,0,0"><TextBlock Text="Modified" /></Border>
                            </StackPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding UpdatePresetCommand}" Margin="0,0,8,8"
                                        Content="{Binding PresetName}" ContentStringFormat="Update &quot;{0}&quot;" />
                                <TextBox Style="{StaticResource Input}" Width="220" Margin="0,0,8,8" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                                         mah:TextBoxHelper.Watermark="New preset name" AutomationProperties.Name="New preset name" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Save as new preset" Command="{Binding SaveAsNewPresetCommand}" Margin="0,0,0,8" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Small}" Text="Or leave it: this run is in History with its seed either way. Presets keep settings, not seeds." />
                        </StackPanel>
                        <StackPanel Margin="0,20,0,0" Visibility="{Binding NoPreset, Converter={StaticResource Show}}">
                            <TextBlock Style="{StaticResource Strong}" Text="Save these settings as a preset" />
                            <WrapPanel Margin="0,8,0,0">
                                <TextBox Style="{StaticResource Input}" Width="300" Margin="0,0,8,8" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                                         mah:TextBoxHelper.Watermark="Preset name, e.g. Friday night chaos" AutomationProperties.Name="Preset name" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Save preset" Command="{Binding SaveAsNewPresetCommand}" Margin="0,0,0,8" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Small}" Text="A preset keeps the settings but not the seed, so every run from it is a new game. This exact game stays in History." />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,20,0,0" Visibility="{Binding PresetMatches, Converter={StaticResource Show}}"
                                   Text="{Binding PresetName, StringFormat='Made with preset &quot;{0}&quot;.'}" />
                        <TextBlock Style="{StaticResource Small}" Foreground="{StaticResource GoodText}" Text="{Binding PresetMessage}" Margin="0,6,0,0" />

                        <Border Background="{StaticResource PanelHeader}" CornerRadius="6" Padding="16,14" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Strong}" Text="{Binding SaveAdviceTitle}" />
                                <TextBlock Style="{StaticResource Body}" Text="{Binding SaveAdvice}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <Border Background="{StaticResource Control}" CornerRadius="6,6,0,0" Padding="16,10" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="What changed" Style="{StaticResource Strong}" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding Changes}" Margin="16,8,16,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,2" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,20,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Launch FINAL FANTASY X" Height="44" Command="{Binding LaunchGameCommand}" Margin="0,0,12,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Open spoiler log" Height="44" Command="{Binding OpenSpoilerCommand}" Margin="0,0,12,0"
                                    Visibility="{Binding HasSpoiler, Converter={StaticResource Show}}" />
                            <Button Style="{StaticResource LinkButton}" Content="Back to options" Command="{Binding CloseCommand}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Small}" Margin="0,12,0,0"
                                   Text="To undo it, open FFX Randomizer and choose Restore original. A Steam update or &quot;Verify integrity of game files&quot; also undoes it." />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProblemViewModel}">
            <Grid Background="#B30B0F14">
                <Border Style="{StaticResource Card}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <Border x:Name="Header" Background="{StaticResource PanelHeader}" CornerRadius="6,6,0,0" Padding="16,12">
                            <TextBlock x:Name="HeaderText" Text="{Binding Title}" Style="{StaticResource Strong}" FontSize="15" />
                        </Border>
                        <StackPanel Margin="16,14,16,16">
                            <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" />
                            <WrapPanel Margin="0,16,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="{Binding ActionLabel}" Command="{Binding ActCommand}" Margin="0,0,10,0" IsDefault="True" />
                                <Button Style="{StaticResource SecondaryButton}" Content="{Binding SecondaryLabel}" Command="{Binding SecondaryCommand}"
                                        Visibility="{Binding HasSecondary, Converter={StaticResource Show}}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Warning">
                    <Setter TargetName="Header" Property="Background" Value="{StaticResource WarnBack}" />
                    <Setter TargetName="HeaderText" Property="Foreground" Value="{StaticResource WarnText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Error">
                    <Setter TargetName="Header" Property="Background" Value="{StaticResource BadBack}" />
                    <Setter TargetName="HeaderText" Property="Foreground" Value="{StaticResource BadText}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NamePromptViewModel}">
            <Grid Background="#B30B0F14">
                <Border Style="{StaticResource Card}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Margin="16">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}" FontSize="15" />
                        <TextBox Style="{StaticResource Input}" Margin="0,12,0,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="Preset name" AutomationProperties.Name="Preset name" />
                        <WrapPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" Margin="0,0,10,0" IsDefault="True" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </mah:MetroWindow.Resources>

    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <Button ToolTip="{Binding UpdateTooltip}" Command="{Binding OpenUpdateCommand}" Cursor="Hand" Opacity="1"
                    Visibility="{Binding HasUpdate, Converter={StaticResource Show}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="#E8B04A" CornerRadius="11" Padding="12,3" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UpdateLabel}" Foreground="#1B2433" FontWeight="SemiBold" FontSize="13" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#F4C766" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <Grid>
        <DockPanel>
            <!-- Bottom bar -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource Rail}" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding GameDetail}">
                        <TextBlock Text="{Binding GameTitle}" Style="{StaticResource Strong}" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,4" />
                        <Border Style="{StaticResource GoodChip}" HorizontalAlignment="Left" Visibility="{Binding StatusIsRandomized, Converter={StaticResource Show}}">
                            <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Border Style="{StaticResource Chip}" Background="{StaticResource TagBack}" HorizontalAlignment="Left"
                                Visibility="{Binding StatusIsRandomized, Converter={x:Static vm:Converters.HideWhenTrue}}">
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TagText}" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource TextRail}" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Run Text="Preset" /> <Run Text="{Binding PresetLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        </TextBlock>
                        <Border Style="{StaticResource WarnChip}" Margin="0,0,8,0" Visibility="{Binding IsModified, Converter={StaticResource Show}}">
                            <TextBlock Text="Modified" />
                        </Border>
                        <Button Style="{StaticResource SecondaryButton}" Content="Update preset" Margin="0,0,8,0" Command="{Binding UpdateLoadedPresetCommand}"
                                Visibility="{Binding IsModified, Converter={StaticResource Show}}" />
                        <Button Style="{StaticResource IconButton}" ToolTip="Save as a new preset" AutomationProperties.Name="Save settings as a new preset"
                                Margin="0,0,16,0" Command="{Binding PromptNewPresetCommand}">
                            <Path Style="{StaticResource IconPath}" Data="M3.5,2 L12.5,2 L12.5,14 L8,11 L3.5,14 Z" />
                        </Button>
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding UseFixedSeed}" Content="Set seed" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource Input}" Width="150" Text="{Binding SeedText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseFixedSeed}"
                                 mah:TextBoxHelper.Watermark="Random each time" AutomationProperties.Name="Seed" Margin="0,0,16,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Restore original" Margin="0,0,12,0" Command="{Binding RestoreCommand}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Randomize" Height="40" Padding="22,0" FontSize="15" Command="{Binding RandomizeCommand}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Left menu -->
            <Border DockPanel.Dock="Left" Width="220" Background="{StaticResource Rail}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0" Padding="0,16">
                <ItemsControl ItemsSource="{Binding Tabs}" AutomationProperties.Name="Option categories">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TabViewModel}">
                            <StackPanel>
                                <Rectangle Height="1" Fill="{StaticResource Divider}" Margin="20,12" Visibility="{Binding StartsSection, Converter={StaticResource Show}}" />
                                <RadioButton Style="{StaticResource RailTab}" GroupName="Tabs" IsChecked="{Binding IsSelected}"
                                             AutomationProperties.Name="{Binding Label}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Visibility="{Binding CountLabel, Converter={x:Static vm:Converters.ShowWhenNotNull}}">
                                            <TextBlock Text="{Binding CountLabel}" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </RadioButton>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Content -->
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="28,20,28,12" BorderBrush="#222A35" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTab.Label}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding SelectedTab.Blurb}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Grid>
                    <ScrollViewer Visibility="{Binding IsOptionsTab, Converter={StaticResource Show}}" Padding="28,16,28,12">
                        <ItemsControl ItemsSource="{Binding SelectedTab.Groups}" ItemTemplate="{StaticResource GroupTemplate}" />
                    </ScrollViewer>

                    <ScrollViewer Visibility="{Binding IsPresetsTab, Converter={StaticResource Show}}" Padding="28,16,28,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Save current settings as a new preset"
                                        Command="{Binding PromptNewPresetCommand}" />
                                <TextBlock Text="Your presets" Style="{StaticResource Strong}" FontSize="15" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="No presets yet. Set up options you like, then save them here." Style="{StaticResource Muted}" Margin="0,0,0,12"
                                       Visibility="{Binding MyPresets.Count, Converter={x:Static vm:Converters.ShowWhenZero}}" />
                            <ItemsControl ItemsSource="{Binding MyPresets}" ItemTemplate="{StaticResource PresetTemplate}" />
                            <TextBlock Text="Built in" Style="{StaticResource Strong}" FontSize="15" Margin="0,12,0,4" />
                            <TextBlock Text="Built-in presets can't be changed. Duplicate one to make your own version." Style="{StaticResource Small}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding BuiltInPresets}" ItemTemplate="{StaticResource PresetTemplate}" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Visibility="{Binding IsHistoryTab, Converter={StaticResource Show}}" Padding="28,16,28,12">
                        <StackPanel>
                            <TextBlock Text="Nothing here yet. Every time you click Randomize, the run is saved here." Style="{StaticResource Muted}"
                                       Visibility="{Binding History.Count, Converter={x:Static vm:Converters.ShowWhenZero}}" />
                            <ItemsControl ItemsSource="{Binding History}" ItemTemplate="{StaticResource HistoryTemplate}" />
                            <TextBlock Style="{StaticResource Small}" Margin="0,4,0,0"
                                       Text="Use settings loads that run's options with a new random seed, for a fresh game. Replay this seed loads the options and the seed, which makes the exact same game again (on the same app version)." />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </DockPanel>

        <ContentControl Content="{Binding Overlay}" Visibility="{Binding HasOverlay, Converter={StaticResource Show}}" Focusable="False" />
    </Grid>
</mah:MetroWindow>
